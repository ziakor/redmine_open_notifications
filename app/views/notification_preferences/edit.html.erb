<h2><%= l(:label_notification_preferences) %></h2>

<div class="flash notice" style="margin-bottom: 16px; background: #f0f9ff; border: 1px solid #bae6fd; color: #0369a1; border-radius: 6px; padding: 12px 16px; font-size: 13px;">
  <strong>ℹ️ <%= l(:label_redmine_sync_info_title) %> :</strong> <%= l(:text_redmine_sync_info_body) %>
  <%= link_to l(:label_my_account), { controller: 'my', action: 'account' }, style: "text-decoration: underline; font-weight: 600; color: #0284c7;" %>.
</div>

<%= form_for @preference, url: notification_preference_path, method: :put do |f| %>
  <fieldset class="box tabular">
    <legend><%= l(:label_notification_scope_section) %></legend>
    <p>
      <%= f.label :notification_scope, l(:label_notification_scope) %>
      <%= f.select :notification_scope, [
        [l(:option_scope_redmine_default), 'redmine_default'],
        [l(:option_scope_only_involved), 'only_involved'],
        [l(:option_scope_all_events), 'all_events'],
        [l(:option_scope_mentions_only), 'mentions_only']
      ] %>
      <br>
      <em class="info"><%= l(:text_notification_scope_hint) %></em>
    </p>
  </fieldset>

  <fieldset class="box tabular">
    <legend><%= l(:label_notification_channels) %></legend>
    <p>
      <%= f.label :webpush_enabled, l(:label_webpush_settings) %>
      <%= f.check_box :webpush_enabled %>
      <em class="info"><%= l(:text_webpush_hint) %></em>
    </p>
  </fieldset>

  <fieldset class="box tabular">
    <legend><%= l(:label_event_filters) %></legend>
    <p>
      <label><%= l(:label_receive_alerts_for) %></label>
      <span style="display: inline-flex; gap: 12px; flex-wrap: wrap; padding-top: 4px;">
        <% user_events = @preference.events_list %>
        <% [
          [:label_event_mentions_me, "user_mentioned"],
          [:label_event_issues_created, "issue_created"],
          [:label_event_issues_updated, "issue_updated"],
          [:label_event_notes_added, "note_added"]
        ].each do |label_key, event_code| %>
          <label style="margin-left: 0; font-weight: normal; width: auto;">
            <%= check_box_tag "user_notification_preference[enabled_events][]", event_code, user_events.include?(event_code) %>
            <%= l(label_key) %>
          </label>
        <% end %>
      </span>
      <br>
      <em class="info"><%= l(:text_event_filters_hint) %></em>
    </p>
  </fieldset>

  <fieldset class="box tabular">
    <legend><%= l(:label_quiet_hours) %></legend>
    <p>
      <%= f.label :quiet_hours_start, l(:label_quiet_hours_start) %>
      <%= f.text_field :quiet_hours_start, placeholder: "18:00", size: 10 %>
      <em class="info"><%= l(:text_quiet_hours_start_hint) %></em>
    </p>
    <p>
      <%= f.label :quiet_hours_end, l(:label_quiet_hours_end) %>
      <%= f.text_field :quiet_hours_end, placeholder: "08:30", size: 10 %>
      <em class="info"><%= l(:text_quiet_hours_end_hint) %></em>
    </p>
    <p>
      <label><%= l(:label_active_days) %></label>
      <span style="display: inline-flex; gap: 12px; flex-wrap: wrap; padding-top: 4px;">
        <% active_days = (@preference.work_days || "1,2,3,4,5").split(',') %>
        <% day_names = l('date.day_names') %>
        <% [1, 2, 3, 4, 5, 6, 0].each do |day_index| %>
          <label style="margin-left: 0; font-weight: normal; width: auto;">
            <%= check_box_tag "user_notification_preference[work_days][]", day_index.to_s, active_days.include?(day_index.to_s) %>
            <%= day_names[day_index].capitalize %>
          </label>
        <% end %>
      </span>
      <br>
      <em class="info"><%= l(:text_active_days_hint) %></em>
    </p>
  </fieldset>

  <fieldset class="box tabular">
    <legend><%= l(:label_digest_settings) %></legend>
    <p>
      <%= f.label :digest_enabled, l(:label_enable_digest) %>
      <%= f.check_box :digest_enabled %>
      <em class="info"><%= l(:text_digest_hint) %></em>
    </p>
  </fieldset>

  <p>
    <%= submit_tag l(:button_save_preferences), class: 'button' %>
    <%= link_to l(:button_cancel), :back, class: 'button-secondary' %>
  </p>
<% end %>

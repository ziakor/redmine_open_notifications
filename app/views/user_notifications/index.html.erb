<h2>Historique des Notifications</h2>

<% if @notifications.any? %>
  <div style="margin-bottom: 15px; display: flex; gap: 8px;">
    <%= button_to "Tout marquer comme lu", read_all_user_notifications_path, method: :post, class: 'button' %>
    <%= button_to "Tout supprimer", clear_all_user_notifications_path, method: :post, data: { confirm: "Êtes-vous sûr de vouloir supprimer toutes vos notifications ?" }, class: 'button' %>
  </div>

  <table class="list notifications-table">
    <thead>
      <tr>
        <th style="width: 90px; text-align: center;">Statut</th>
        <th style="width: 140px;">Date</th>
        <th style="width: 150px;">Projet</th>
        <th>Message & Ticket</th>
        <th style="width: 220px; text-align: center;">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @notifications.each do |n| %>
        <tr class="<%= n.read_at.nil? ? 'unread-row' : 'read-row' %>">
          <td style="text-align: center;">
            <% if n.read_at.nil? %>
              <span class="badge-unread">● Non lue</span>
            <% else %>
              <span class="badge-read">✓ Lue</span>
            <% end %>
          </td>
          <td><%= format_time(n.created_at) %></td>
          <td><%= link_to n.project.name, project_path(n.project) if n.project %></td>
          <td>
            <% if n.issue && n.event_type != 'digest_summary' %>
              <strong><%= link_to "##{n.issue_id} #{n.issue.subject}", issue_path(n.issue) %></strong>
              <br>
            <% end %>
            <span class="notif-title-text" style="font-weight: 600;"><%= n.title %></span>
            <% if n.body.present? %>
              <br><small style="color: #444; line-height: 1.4; display: block; margin-top: 4px;"><%= n.body.html_safe %></small>
            <% end %>
          </td>
          <td style="text-align: center;">
            <div style="display: flex; gap: 4px; justify-content: center; align-items: center;">
              <% if n.read_at.nil? %>
                <%= button_to "Marquer lu", user_notification_path(n), method: :put, class: 'button-small' %>
                <%= button_to "Snooze 2h", snooze_user_notification_path(n), method: :post, class: 'button-small' %>
              <% end %>
              <%= button_to "Supprimer", user_notification_path(n), method: :delete, data: { confirm: "Supprimer cette notification ?" }, class: 'button-small' %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="nodata">Aucune notification pour le moment.</p>
<% end %>

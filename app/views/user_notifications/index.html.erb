<h2><%= l(:label_notification_history) %></h2>

<% if @notifications.any? %>
  <div style="margin-bottom: 15px; display: flex; gap: 8px;">
    <%= button_to l(:label_mark_all_read), read_all_user_notifications_path, method: :post, class: 'button' %>
    <%= button_to l(:button_delete_all_notifications), clear_all_user_notifications_path, method: :post, data: { confirm: l(:text_confirm_delete_all_notifications) }, class: 'button' %>
  </div>

  <table class="list notifications-table">
    <thead>
      <tr>
        <th style="width: 90px; text-align: center;"><%= l(:label_notification_status) %></th>
        <th style="width: 140px;"><%= l(:label_notification_date) %></th>
        <th style="width: 150px;"><%= l(:label_notification_project) %></th>
        <th><%= l(:label_notification_message) %></th>
        <th style="width: 220px; text-align: center;"><%= l(:label_notification_actions) %></th>
      </tr>
    </thead>
    <tbody>
      <% @notifications.each do |n| %>
        <tr class="<%= n.read_at.nil? ? 'unread-row' : 'read-row' %>">
          <td style="text-align: center;">
            <% if n.read_at.nil? %>
              <span class="badge-unread">● <%= l(:label_notification_unread) %></span>
            <% else %>
              <span class="badge-read">✓ <%= l(:label_notification_read) %></span>
            <% end %>
          </td>
          <td><%= format_time(n.created_at) %></td>
          <td><%= link_to n.project.name, project_path(n.project) if n.project %></td>
          <td>
            <% if n.issue && n.event_type != 'digest_summary' %>
              <strong><%= link_to "##{n.issue_id} #{n.issue.subject}", issue_path(n.issue) %></strong>
              <br>
            <% end %>
            <span class="notif-title-text" style="font-weight: 600;"><%= n.title %></span>
            <% if n.body.present? %>
              <br><small style="color: #444; line-height: 1.4; display: block; margin-top: 4px;"><%= n.body.html_safe %></small>
            <% end %>
          </td>
          <td style="text-align: center;">
            <div style="display: flex; gap: 4px; justify-content: center; align-items: center;">
              <% if n.read_at.nil? %>
                <%= button_to l(:button_mark_notification_read), user_notification_path(n), method: :put, class: 'button-small' %>
                <%= button_to l(:button_snooze_notification), snooze_user_notification_path(n), method: :post, class: 'button-small' %>
              <% end %>
              <%= button_to l(:button_delete_notification), user_notification_path(n), method: :delete, data: { confirm: l(:text_confirm_delete_notification) }, class: 'button-small' %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="nodata"><%= l(:text_no_notifications) %></p>
<% end %>
